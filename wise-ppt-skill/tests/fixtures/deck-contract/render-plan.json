{
  "contract_version": 2,
  "output_file": "index.html",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "typography_mode": "mixed",
  "pages": [
    {
      "page_id": "page.example-flow-kpi",
      "layout_decision": {
        "source": "composition",
        "recipe_id": "paper-ink.flow.pipeline",
        "candidate_evaluations": [
          {
            "recipe_id": "paper-ink.flow.pipeline",
            "verdict": "structure_fit",
            "reason": "流程关系、线性原语与槽位顺序符合，组件内容需要重新组合。"
          }
        ]
      },
      "rationale": "四步输入输出是线性流，使用 recipe 的结构合同组合流程、结果与结论三个组件。",
      "slots": [
        {
          "slot_id": "steps",
          "block_id": "block.pipeline",
          "visual_role": "primary",
          "renderer": {
            "renderer_kind": "svg",
            "component_source": "native",
            "component_id": "pipeline",
            "content_refs": [
              "item.delivery-process"
            ],
            "data_binding": {
              "data_ref": {
                "content_id": "item.delivery-process",
                "json_pointer": "/structured_data/steps"
              },
              "dataset_id": "dataset.delivery-steps",
              "encode": {
                "order": "array-order",
                "label": "value"
              }
            },
            "theme_adapter_id": "paper-ink.svg"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.outcome-kpis",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "kpi-band",
            "content_refs": [
              "item.delivery-outcomes"
            ],
            "theme_adapter_id": "paper-ink.typography"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.flow-takeaway",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "takeaway",
            "content_refs": [
              "item.flow-takeaway"
            ],
            "theme_adapter_id": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.example-dense-ui",
      "layout_decision": {
        "source": "composition",
        "recipe_id": "paper-ink.evidence.admin-ui",
        "candidate_evaluations": [
          {
            "recipe_id": "paper-ink.evidence.admin-ui",
            "verdict": "structure_fit",
            "reason": "证据关系、空间原语与槽位顺序符合，界面和趋势组件需要重新组合。"
          }
        ]
      },
      "typography_decision": {
        "mode": "all-sans",
        "reason": "界面证据页以 UI 与操作状态为主，全无衬线更贴合信息角色。"
      },
      "rationale": "沿用界面、图表、批注与结论的结构合同，分别绑定可验证的证据组件。",
      "slots": [
        {
          "slot_id": "product-ui",
          "block_id": "block.product-ui",
          "visual_role": "primary",
          "renderer": {
            "renderer_kind": "native-html",
            "component_source": "native",
            "component_id": "admin-dashboard",
            "content_refs": [
              "item.product-ui-state"
            ],
            "theme_adapter_id": "paper-ink.native-html"
          }
        },
        {
          "slot_id": "chart",
          "block_id": "block.embedded-chart",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "canvas",
            "component_source": "native",
            "component_id": "canvas-line-chart",
            "content_refs": [
              "item.product-latency-series"
            ],
            "data_binding": {
              "data_ref": {
                "content_id": "item.product-latency-series",
                "json_pointer": "/structured_data/points"
              },
              "dataset_id": "dataset.product-latency",
              "encode": {
                "x": 0,
                "y": 1
              }
            },
            "theme_adapter_id": "paper-ink.canvas"
          }
        },
        {
          "slot_id": "annotation",
          "block_id": "block.anomaly-note",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "anomaly-note",
            "content_refs": [
              "item.product-anomaly-note"
            ],
            "theme_adapter_id": "paper-ink.typography"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.recovery-status",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "recovery-status",
            "content_refs": [
              "item.product-ui-state"
            ],
            "theme_adapter_id": "paper-ink.typography"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.ui-takeaway",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "takeaway",
            "content_refs": [
              "item.ui-takeaway"
            ],
            "theme_adapter_id": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "semantic-focus",
        "content_ref": "item.product-anomaly-note",
        "member_roles": [
          "status",
          "outline",
          "annotation"
        ],
        "reason": "强调异常判断，使状态、轮廓和批注共同指向同一语义焦点。"
      }
    }
  ]
}
