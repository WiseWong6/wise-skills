        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "paper-ink.evidence.admin-ui",
        "candidate_evaluations": [
          {
            "layout_id": "paper-ink.evidence.admin-ui",
            "verdict": "fit",
            "reason": "角色、证据关系、空间原语、容量与槽位顺序均符合本页需求。"
          }
        ]
      },
      "rationale": "保留界面、图表、批注与结论的规范顺序，并替换前三个组件以承载真实证据。",
      "slots": [
        {
          "slot_id": "product-ui",
          "block_id": "block.product-ui",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "以真实后台界面替换样例中的通用主证据面。"
          },
          "renderer": {
