{
  "schema_version": "1.1",
  "document_mode": "single-html",
  "output_file": "index.html",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "pages": [
    {
      "page_id": "page.example-flow-kpi",
      "layout_id": "paper-ink.flow.pipeline",
      "reuse_mode": "adapt",
      "reuse_source": "paper-ink.flow.pipeline",
      "density": "balanced",
      "rationale": "四步输入输出是线性流，保留三段结构并替换结果组件，三个语义单元在版式容量内。",
      "capacity_status": "fit",
      "core_primitive": "linear-sequence",
      "theme_primitives": ["linear-sequence"],
      "html_attributes": {
        "data-page-id": "page.example-flow-kpi",
        "data-page-role": "sequence",
        "data-theme": "paper-ink",
        "data-layout-source": "gallery",
        "data-layout": "paper-ink.flow.pipeline",
        "data-density": "balanced",
        "data-reuse-mode": "adapt",
        "data-page-title": "四步可追溯流水线把交付周期压到 2 天",
        "data-page-summary": "横向流程说明机制，结果带证明价值。",
        "data-section-id": "section.flow",
        "data-section-title": "交付机制"
      },
      "slots": [
        {
          "slot_id": "steps",
          "block_id": "block.pipeline",
          "visual_role": "primary",
          "renderer": {
            "provider": "svg",
            "component": "pipeline",
            "content_refs": ["item.delivery-process"],
            "data_ref": "item.delivery-process",
            "encode": {"order": "steps"},
            "theme_adapter": "paper-ink.svg"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.outcome-kpis",
          "visual_role": "support",
          "renderer": {
            "provider": "typography",
            "component": "kpi-band",
            "content_refs": ["item.delivery-outcomes"],
            "theme_adapter": "paper-ink.typography"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.flow-takeaway",
          "visual_role": "support",
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": ["item.flow-takeaway"],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ]
    },
    {
      "page_id": "page.example-dense-ui",
      "layout_id": "paper-ink.evidence.admin-ui",
      "reuse_mode": "adapt",
      "reuse_source": "paper-ink.evidence.admin-ui",
      "density": "dense",
      "rationale": "保留界面、图表、批注与结论的规范顺序，并替换前三个组件以承载真实证据。",
      "capacity_status": "fit",
      "core_primitive": "evidence-annotation",
      "theme_primitives": ["evidence-annotation"],
      "html_attributes": {
        "data-page-id": "page.example-dense-ui",
        "data-page-role": "prove",
        "data-theme": "paper-ink",
        "data-layout-source": "gallery",
        "data-layout": "paper-ink.evidence.admin-ui",
        "data-density": "dense",
        "data-reuse-mode": "adapt",
        "data-page-title": "一次 620ms 峰值触发重试，随后系统恢复",
        "data-page-summary": "界面、趋势和批注共享一个证据面。",
        "data-section-id": "section.ops",
        "data-section-title": "异常证据"
      },
      "slots": [
        {
          "slot_id": "product-ui",
          "block_id": "block.product-ui",
          "visual_role": "primary",
          "renderer": {
            "provider": "native-html",
            "component": "admin-dashboard",
            "content_refs": ["item.product-ui-state"],
            "theme_adapter": "paper-ink.native-html"
          }
        },
        {
          "slot_id": "chart",
          "block_id": "block.embedded-chart",
          "visual_role": "support",
          "renderer": {
            "provider": "echarts",
            "component": "line",
            "content_refs": ["item.product-latency-series"],
            "data_ref": "item.product-latency-series",
            "encode": {"x": "time", "y": "latency_ms"},
            "theme_adapter": "paper-ink.echarts"
          }
        },
        {
          "slot_id": "annotation",
          "block_id": "block.anomaly-note",
          "visual_role": "support",
          "renderer": {
            "provider": "svg",
            "component": "elbow-callout",
            "content_refs": ["item.product-anomaly-note"],
            "theme_adapter": "paper-ink.svg"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.ui-takeaway",
          "visual_role": "support",
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": ["item.ui-takeaway"],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ]
    }
  ]
}
