{
  "schema_version": "2.0",
  "document_mode": "single-html",
  "output_file": "index.html",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "pages": [
    {
      "page_id": "page.example-flow-kpi",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "paper-ink.flow.pipeline",
        "candidate_evaluations": [
          {
            "layout_id": "paper-ink.flow.pipeline",
            "verdict": "fit",
            "reason": "角色、流程关系、线性原语、容量与槽位顺序均符合本页需求。"
          }
        ]
      },
      "rationale": "四步输入输出是线性流，保留三段结构并替换结果组件，三个语义单元在版式容量内。",
      "slots": [
        {
          "slot_id": "steps",
          "block_id": "block.pipeline",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "以真实四步流程 SVG 替换样例中的通用主视觉。"
          },
          "renderer": {
            "provider": "svg",
            "component": "pipeline",
            "content_refs": [
              "item.delivery-process"
            ],
            "data_ref": "item.delivery-process",
            "encode": {
              "order": "steps"
            },
            "theme_adapter": "paper-ink.svg"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.outcome-kpis",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "KPI 支撑槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "kpi-band",
            "content_refs": [
              "item.delivery-outcomes"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.flow-takeaway",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "结论槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": [
              "item.flow-takeaway"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.example-dense-ui",
