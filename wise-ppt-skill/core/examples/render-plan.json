{
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "core-example",
  "output_file": "index.html",
  "pages": [
    {
      "page_id": "page.opening",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "copy",
        "layout_id": "core-example.focus.statement",
        "candidate_evaluations": [
          {
            "layout_id": "core-example.focus.statement",
            "verdict": "fit",
            "reason": "单一主张、焦点关系、阅读顺序和容量均完整满足。"
          }
        ]
      },
      "rationale": "页面只有一个反直觉判断，关系、容量和文字主角槽位均与已验证样例完全匹配。",
      "slots": [
        {
          "slot_id": "hero",
          "block_id": "block.opening-claim",
          "visual_role": "primary",
          "component_decision": {
            "action": "keep",
            "reason": "原 Typography 组件能完整承载单一判断。"
          },
          "renderer": {
            "provider": "typography",
            "component": "assertion-title",
            "variant": "single-statement",
            "content_refs": [
              "item.deck-thesis",
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.type-emphasis"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.six-stage-loop",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "core-example.flow.looped-sequence",
        "candidate_evaluations": [
          {
            "layout_id": "core-example.flow.looped-sequence",
            "verdict": "fit",
            "reason": "六阶段顺序、回流关系、双槽区域和高密容量全部满足。"
          }
        ]
      },
      "rationale": "六项信息有明确先后并需要回流箭头，保留序列骨架并替换主路径 renderer，比六宫格更准确。",
      "slots": [
        {
          "slot_id": "main-path",
          "block_id": "block.stage-path",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "保留区域结构，改用 SVG 精确表达六阶段回流。"
          },
          "renderer": {
            "provider": "svg",
            "component": "looped-sequence-path",
            "variant": "six-stage",
            "content_refs": [
              "item.launch-path",
              "atom.stage.discover",
              "atom.stage.scope",
              "atom.stage.build",
              "atom.stage.verify",
              "atom.stage.launch",
              "atom.stage.learn"
            ],
            "data_ref": "item.launch-path.atomic_values",
            "encode": {
              "order": "array-order",
              "node_label": "value",
              "return_edge": "atom.loop-outcome"
            },
            "theme_adapter": "core-example.line-system"
          }
        },
        {
          "slot_id": "return-note",
          "block_id": "block.loop-note",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "原注释组件与支持信息的角色和容量完全匹配。"
          },
          "renderer": {
            "provider": "typography",
            "component": "edge-annotation",
            "variant": null,
            "content_refs": [
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.annotation"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.close",
      "layout_decision": {
        "source": "custom",
        "reuse_mode": "custom",
        "layout_id": "custom.core-example.close",
        "candidate_evaluations": [],
        "custom_contract": {
          "reading_order": [
            "closing-statement"
          ],
          "capacity": {
            "semantic_units": {
              "min": 1,
              "max": 2
            }
          },
          "regions": [
            {
              "slot_id": "closing-statement",
              "block_id": "block.close-claim",
              "visual_role": "primary",
              "min_items": 1,
              "max_items": 2
            }
          ]
        }
      },
      "rationale": "Gallery 没有满足当前收束要求的候选，按页内契约自由构建单一焦点区域。",
      "slots": [
        {
          "slot_id": "closing-statement",
          "block_id": "block.close-claim",
          "visual_role": "primary",
          "component_decision": {
            "action": "select",
            "reason": "根据收束语义重新选择原生 Typography 表达。"
          },
          "renderer": {
            "provider": "typography",
            "component": "closing-assertion",
            "variant": null,
            "content_refs": [
              "item.deck-thesis",
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.type-emphasis"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    }
  ]
}
