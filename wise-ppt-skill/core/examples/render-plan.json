{
  "schema_version": "2.0",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "core-example",
  "document_mode": "single-html",
  "output_file": "index.html",
  "pages": [
    {
      "page_id": "page.opening",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "copy",
        "layout_id": "core-example.focus.statement",
        "candidate_evaluations": [
          {
            "layout_id": "core-example.focus.statement",
            "verdict": "fit",
            "reason": "单一主张、焦点关系、阅读顺序和容量均完整满足。"
          }
        ]
      },
      "density": "breathing",
      "rationale": "页面只有一个反直觉判断，关系、容量和文字主角槽位均与已验证样例完全匹配。",
      "capacity_status": "fit",
      "core_primitive": "focus-field",
      "html_attributes": {
        "data-page-id": "page.opening",
        "data-page-role": "hook",
        "data-theme": "core-example",
        "data-layout-source": "gallery",
        "data-layout": "core-example.focus.statement",
        "data-density": "breathing",
        "data-reuse-mode": "copy",
        "data-page-title": "上线只是过程中的一个节点",
        "data-page-summary": "学习结果必须进入下一轮发现。",
        "data-section-id": "section.opening",
        "data-section-title": "建立判断"
      },
      "slots": [
        {
          "slot_id": "hero",
          "block_id": "block.opening-claim",
          "visual_role": "primary",
          "component_decision": {
            "action": "keep",
            "reason": "原 Typography 组件能完整承载单一判断。"
          },
          "renderer": {
            "provider": "typography",
            "component": "assertion-title",
            "variant": "single-statement",
            "content_refs": [
              "item.deck-thesis",
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.type-emphasis"
          }
        }
      ]
    },
    {
      "page_id": "page.six-stage-loop",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "core-example.flow.looped-sequence",
        "candidate_evaluations": [
          {
            "layout_id": "core-example.flow.looped-sequence",
            "verdict": "fit",
            "reason": "六阶段顺序、回流关系、双槽区域和高密容量全部满足。"
          }
        ]
      },
      "density": "dense",
      "rationale": "六项信息有明确先后并需要回流箭头，保留序列骨架并替换主路径 renderer，比六宫格更准确。",
      "capacity_status": "fit",
      "core_primitive": "linear-sequence",
      "html_attributes": {
        "data-page-id": "page.six-stage-loop",
        "data-page-role": "sequence",
        "data-theme": "core-example",
        "data-layout-source": "gallery",
        "data-layout": "core-example.flow.looped-sequence",
        "data-density": "dense",
        "data-reuse-mode": "adapt",
        "data-page-title": "六个阶段首尾相接，而不是六个孤立格子",
        "data-page-summary": "发现、界定、构建、验证、发布与学习按顺序推进，并由学习回流到发现。",
        "data-section-id": "section.mechanism",
        "data-section-title": "展示机制"
      },
      "slots": [
        {
          "slot_id": "main-path",
          "block_id": "block.stage-path",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "保留区域结构，改用 SVG 精确表达六阶段回流。"
          },
          "renderer": {
            "provider": "svg",
            "component": "looped-sequence-path",
            "variant": "six-stage",
            "content_refs": [
              "item.launch-path",
              "atom.stage.discover",
              "atom.stage.scope",
              "atom.stage.build",
              "atom.stage.verify",
              "atom.stage.launch",
              "atom.stage.learn"
            ],
            "data_ref": "item.launch-path.atomic_values",
            "encode": {
              "order": "array-order",
              "node_label": "value",
              "return_edge": "atom.loop-outcome"
            },
            "theme_adapter": "core-example.line-system"
          }
        },
        {
          "slot_id": "return-note",
          "block_id": "block.loop-note",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "原注释组件与支持信息的角色和容量完全匹配。"
          },
          "renderer": {
            "provider": "typography",
            "component": "edge-annotation",
            "variant": null,
            "content_refs": [
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.annotation"
          }
        }
      ]
    },
    {
      "page_id": "page.close",
      "layout_decision": {
        "source": "custom",
        "reuse_mode": "custom",
        "layout_id": "custom.core-example.close",
        "candidate_evaluations": [],
        "custom_contract": {
          "reading_order": [
            "closing-statement"
          ],
          "capacity": {
            "semantic_units": {
              "min": 1,
              "max": 2
            }
          },
          "regions": [
            {
              "slot_id": "closing-statement",
              "block_id": "block.close-claim",
              "visual_role": "primary",
              "min_items": 1,
              "max_items": 2
            }
          ]
        }
      },
      "density": "breathing",
      "rationale": "Gallery 没有满足当前收束要求的候选，按页内契约自由构建单一焦点区域。",
      "capacity_status": "fit",
      "core_primitive": "focus-field",
      "html_attributes": {
        "data-page-id": "page.close",
        "data-page-role": "close",
        "data-theme": "core-example",
        "data-layout-source": "custom",
        "data-layout": "custom.core-example.close",
        "data-density": "breathing",
        "data-reuse-mode": "custom",
        "data-page-title": "每次发布都应留下下一轮可用的学习",
        "data-page-summary": "没有回流的发布，只完成了交付，没有完成学习。",
        "data-section-id": "section.close",
        "data-section-title": "收束行动"
      },
      "slots": [
        {
          "slot_id": "closing-statement",
          "block_id": "block.close-claim",
          "visual_role": "primary",
          "component_decision": {
            "action": "select",
            "reason": "根据收束语义重新选择原生 Typography 表达。"
          },
          "renderer": {
            "provider": "typography",
            "component": "closing-assertion",
            "variant": null,
            "content_refs": [
              "item.deck-thesis",
              "atom.loop-outcome"
            ],
            "theme_adapter": "core-example.type-emphasis"
          }
        }
      ]
    }
  ]
}
