{
  "contract_version": 2,
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "core-example",
  "typography_mode": "mixed",
  "output_file": "index.html",
  "pages": [
    {
      "page_id": "page.opening",
      "layout_decision": {
        "source": "gallery",
        "recipe_id": "core-example.focus.statement",
        "candidate_evaluations": [
          {
            "recipe_id": "core-example.focus.statement",
            "verdict": "exact_fit",
            "reason": "单一主张、焦点关系、阅读顺序和容量均完整满足。"
          }
        ],
        "payload": {
          "bindings": [
            {
              "slot_id": "headline",
              "content_refs": [
                "item.deck-thesis",
                "atom.loop-outcome"
              ]
            }
          ]
        }
      },
      "rationale": "页面只有一个反直觉判断，完整 Gallery recipe 可按整页 payload 直接绑定。",
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.six-stage-loop",
      "layout_decision": {
        "source": "composition",
        "recipe_id": "core-example.flow.looped-sequence",
        "candidate_evaluations": [
          {
            "recipe_id": "core-example.flow.looped-sequence",
            "verdict": "structure_fit",
            "reason": "六阶段顺序、回流关系、双槽区域和阅读顺序均满足。"
          }
        ]
      },
      "rationale": "六项信息有明确先后并需要回流箭头，使用 recipe 的结构合同重新组合 renderer。",
      "slots": [
        {
          "slot_id": "main-path",
          "block_id": "block.stage-path",
          "visual_role": "primary",
          "renderer": {
            "renderer_kind": "svg",
            "component_source": "native",
            "component_id": "looped-sequence-path",
            "variant": "six-stage",
            "content_refs": [
              "item.launch-path",
              "atom.stage.discover",
              "atom.stage.scope",
              "atom.stage.build",
              "atom.stage.verify",
              "atom.stage.launch",
              "atom.stage.learn"
            ],
            "data_binding": {
              "data_ref": {
                "content_id": "item.launch-path",
                "json_pointer": "/atomic_values"
              },
              "dataset_id": "dataset.launch-stages",
              "encode": {
                "order": "array-order",
                "node_label": "value",
                "return_edge": "atom.loop-outcome"
              }
            },
            "theme_adapter_id": "core-example.line-system"
          }
        },
        {
          "slot_id": "return-note",
          "block_id": "block.loop-note",
          "visual_role": "support",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "edge-annotation",
            "variant": null,
            "content_refs": [
              "atom.loop-outcome"
            ],
            "theme_adapter_id": "core-example.annotation"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    },
    {
      "page_id": "page.close",
      "layout_decision": {
        "source": "custom",
        "candidate_evaluations": [],
        "custom_contract": {
          "reading_order": [
            "closing-statement"
          ],
          "regions": [
            {
              "slot_id": "closing-statement",
              "block_id": "block.close-claim",
              "visual_role": "primary",
              "min_items": 1,
              "max_items": 2
            }
          ]
        }
      },
      "typography_decision": {
        "mode": "all-serif",
        "reason": "收束页只有一句行动判断，使用全衬线强化结论感。"
      },
      "rationale": "Gallery 与 Composition 都没有满足当前收束要求的 recipe，按页内合同构建单一焦点区域。",
      "slots": [
        {
          "slot_id": "closing-statement",
          "block_id": "block.close-claim",
          "visual_role": "primary",
          "renderer": {
            "renderer_kind": "typography",
            "component_source": "native",
            "component_id": "closing-assertion",
            "variant": null,
            "content_refs": [
              "item.deck-thesis",
              "atom.loop-outcome"
            ],
            "theme_adapter_id": "core-example.type-emphasis"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    }
  ]
}
