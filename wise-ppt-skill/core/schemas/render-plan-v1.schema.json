{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/render-plan-v1.schema.json",
  "title": "Wise PPT Render Plan 1.0 and 1.1 compatibility",
  "oneOf": [
    { "$ref": "#/$defs/document_v10" },
    { "$ref": "#/$defs/document_v11" }
  ],
  "$defs": {
    "document_base": {
      "type": "object",
      "required": ["schema_version", "content_file", "deck_plan_file", "theme_id", "pages"],
      "properties": {
        "schema_version": { "enum": ["1.0", "1.1"] },
        "content_file": { "type": "string", "minLength": 1 },
        "deck_plan_file": { "type": "string", "minLength": 1 },
        "theme_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "document_mode": { "const": "single-html" },
        "output_file": { "type": "string", "pattern": "^(?!/)(?!.*[.][.]/).+[.]html$" },
        "pages": { "type": "array", "minItems": 1 }
      }
    },
    "document_v10": {
      "allOf": [
        { "$ref": "#/$defs/document_base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "1.0" },
            "content_file": true,
            "deck_plan_file": true,
            "theme_id": true,
            "pages": { "type": "array", "items": { "$ref": "#/$defs/page_v10" } }
          }
        }
      ]
    },
    "document_v11": {
      "allOf": [
        { "$ref": "#/$defs/document_base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_mode", "output_file"],
          "properties": {
            "schema_version": { "const": "1.1" },
            "content_file": true,
            "deck_plan_file": true,
            "theme_id": true,
            "document_mode": { "const": "single-html" },
            "output_file": true,
            "pages": { "type": "array", "items": { "$ref": "#/$defs/page_v11" } }
          }
        }
      ]
    },
    "content_ref": { "type": "string", "pattern": "^(item|atom)[.]" },
    "core_primitive": {
      "enum": ["focus-field", "bilateral-split", "peer-array", "linear-sequence", "parallel-tracks", "radial-burst", "nested-regions", "layered-stack", "matrix-field", "network-field", "converging-path", "evidence-annotation"]
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "component", "content_refs", "theme_adapter"],
      "properties": {
        "provider": { "enum": ["typography", "table", "image", "native-html", "echarts", "atlas", "svg"] },
        "component": { "type": "string", "minLength": 1 },
        "variant": { "type": ["string", "null"] },
        "content_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content_ref" }, "uniqueItems": true },
        "data_ref": { "type": "string", "minLength": 1 },
        "encode": { "type": "object" },
        "theme_adapter": { "type": "string", "minLength": 1 }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "block_id", "visual_role", "renderer"],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 },
        "block_id": { "type": "string", "pattern": "^block[.]" },
        "visual_role": { "enum": ["primary", "support"] },
        "renderer": { "$ref": "#/$defs/renderer" }
      }
    },
    "html_attributes_base": {
      "type": "object",
      "required": ["data-page-id", "data-page-role", "data-theme", "data-layout", "data-density", "data-reuse-mode"],
      "properties": {
        "data-page-id": { "type": "string", "pattern": "^page[.]" },
        "data-page-role": { "enum": ["hook", "orient", "explain", "prove", "compare", "sequence", "synthesize", "decide", "act", "close"] },
        "data-theme": { "type": "string", "minLength": 1 },
        "data-layout-source": { "enum": ["gallery", "custom"] },
        "data-layout": { "type": "string", "minLength": 1 },
        "data-density": { "enum": ["breathing", "balanced", "dense"] },
        "data-reuse-mode": { "enum": ["copy", "adapt", "compose", "novel"] },
        "data-page-title": { "type": "string", "minLength": 1 },
        "data-page-summary": { "type": "string", "minLength": 1 },
        "data-section-id": { "type": "string", "pattern": "^section[.]" },
        "data-section-title": { "type": "string", "minLength": 1 }
      }
    },
    "html_attributes_v10": {
      "allOf": [
        { "$ref": "#/$defs/html_attributes_base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data-page-id": true, "data-page-role": true, "data-theme": true, "data-layout-source": true,
            "data-layout": true, "data-density": true, "data-reuse-mode": true
          }
        }
      ]
    },
    "html_attributes_v11": {
      "allOf": [
        { "$ref": "#/$defs/html_attributes_base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["data-page-title", "data-page-summary", "data-section-id", "data-section-title"],
          "properties": {
            "data-page-id": true, "data-page-role": true, "data-theme": true, "data-layout-source": true,
            "data-layout": true, "data-density": true, "data-reuse-mode": true,
            "data-page-title": true, "data-page-summary": true,
            "data-section-id": true, "data-section-title": true
          }
        }
      ]
    },
    "page_base": {
      "type": "object",
      "required": ["page_id", "layout_id", "density", "reuse_mode", "rationale", "capacity_status", "core_primitive", "theme_primitives", "html_attributes", "slots"],
      "properties": {
        "page_id": { "type": "string", "pattern": "^page[.]" },
        "output_file": { "type": "string", "pattern": "^(?!/)(?!.*[.][.]/).+[.]html$" },
        "layout_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "density": { "enum": ["breathing", "balanced", "dense"] },
        "reuse_mode": { "enum": ["copy", "adapt", "compose", "novel"] },
        "reuse_source": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 12 },
        "capacity_status": { "enum": ["fit", "underfill", "overflow", "unsupported"] },
        "core_primitive": { "$ref": "#/$defs/core_primitive" },
        "theme_primitives": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "html_attributes": true,
        "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } }
      },
      "allOf": [{
        "if": { "properties": { "reuse_mode": { "enum": ["copy", "adapt", "compose"] } } },
        "then": { "required": ["reuse_source"] }
      }]
    },
    "page_v10": {
      "allOf": [
        { "$ref": "#/$defs/page_base" },
        {
          "type": "object", "additionalProperties": false, "required": ["output_file"],
          "properties": {
            "page_id": true, "output_file": true, "layout_id": true, "density": true,
            "reuse_mode": true, "reuse_source": true, "rationale": true, "capacity_status": true,
            "core_primitive": true, "theme_primitives": true,
            "html_attributes": { "$ref": "#/$defs/html_attributes_v10" }, "slots": true
          }
        }
      ]
    },
    "page_v11": {
      "allOf": [
        { "$ref": "#/$defs/page_base" },
        {
          "type": "object", "additionalProperties": false,
          "not": { "required": ["output_file"] },
          "properties": {
            "page_id": true, "layout_id": true, "density": true,
            "reuse_mode": true, "reuse_source": true, "rationale": true, "capacity_status": true,
            "core_primitive": true, "theme_primitives": true,
            "html_attributes": { "$ref": "#/$defs/html_attributes_v11" }, "slots": true
          }
        }
      ]
    }
  }
}
