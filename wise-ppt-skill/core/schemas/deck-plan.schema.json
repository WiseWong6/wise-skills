{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/deck-plan.schema.json",
  "title": "Wise PPT Semantic Deck Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "content_file",
    "thesis",
    "narrative_type",
    "planning_basis",
    "page_budget",
    "confirmation",
    "sections",
    "pages",
    "coverage_decisions"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "content_file": {
      "type": "string",
      "minLength": 1
    },
    "thesis": {
      "type": [
        "string",
        "null"
      ]
    },
    "narrative_type": {
      "enum": [
        "problem-solution",
        "situation-complication-resolution",
        "chronology",
        "argument-evidence",
        "comparison",
        "funnel",
        "custom"
      ]
    },
    "planning_basis": {
      "$ref": "#/$defs/planning_basis"
    },
    "page_budget": {
      "$ref": "#/$defs/page_budget"
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "coverage_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage_decision"
      }
    }
  },
  "$defs": {
    "content_ref": {
      "type": "string",
      "pattern": "^(item|atom)[.]"
    },
    "item_ref": {
      "type": "string",
      "pattern": "^item[.]"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^src[.]"
    },
    "constraint_ref": {
      "type": "string",
      "pattern": "^constraint[.]"
    },
    "spatial_primitive": {
      "enum": [
        "focus-field",
        "bilateral-split",
        "peer-array",
        "linear-sequence",
        "parallel-tracks",
        "radial-burst",
        "nested-regions",
        "layered-stack",
        "matrix-field",
        "network-field",
        "converging-path",
        "evidence-annotation"
      ]
    },
    "planning_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "scenario",
        "scenario_origin",
        "user_constraint_refs",
        "research_source_refs",
        "assumptions",
        "reason"
      ],
      "properties": {
        "mode": {
          "enum": [
            "user-constrained",
            "derived",
            "scenario-recommended"
          ]
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "scenario_origin": {
          "enum": [
            "user",
            "inferred",
            "researched"
          ]
        },
        "user_constraint_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_ref"
          },
          "uniqueItems": true
        },
        "research_source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "user-constrained"
              }
            }
          },
          "then": {
            "properties": {
              "user_constraint_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario_origin": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario_origin": {
                "const": "researched"
              }
            }
          },
          "then": {
            "properties": {
              "research_source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "page_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "basis",
        "reason"
      ],
      "properties": {
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page_budget_basis"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "page_budget_basis": {
      "oneOf": [
        {
          "$ref": "#/$defs/content_structure_basis"
        },
        {
          "$ref": "#/$defs/user_constraint_basis"
        },
        {
          "$ref": "#/$defs/duration_basis"
        },
        {
          "$ref": "#/$defs/scenario_research_basis"
        }
      ]
    },
    "content_structure_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "content_refs",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "content_structure"
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "user_constraint_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "constraint_refs",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "user_constraint"
        },
        "constraint_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constraint_ref"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "duration_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "constraint_refs",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "duration"
        },
        "constraint_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constraint_ref"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario_research_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_refs",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "scenario_research"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "decision",
        "assessments",
        "user_questions"
      ],
      "properties": {
        "mode": {
          "const": "adaptive"
        },
        "decision": {
          "enum": [
            "proceed",
            "needs_confirmation"
          ]
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confirmation_assessment"
          }
        },
        "user_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "needs_confirmation"
              }
            }
          },
          "then": {
            "properties": {
              "assessments": {
                "contains": {
                  "type": "object",
                  "required": [
                    "resolution"
                  ],
                  "properties": {
                    "resolution": {
                      "const": "needs_user_choice"
                    }
                  }
                },
                "minContains": 1
              },
              "user_questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "proceed"
              }
            }
          },
          "then": {
            "properties": {
              "assessments": {
                "contains": {
                  "type": "object",
                  "required": [
                    "resolution"
                  ],
                  "properties": {
                    "resolution": {
                      "const": "needs_user_choice"
                    }
                  }
                },
                "minContains": 0,
                "maxContains": 0
              },
              "user_questions": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "confirmation_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "affected_refs",
        "impact",
        "resolution",
        "reason"
      ],
      "properties": {
        "trigger": {
          "enum": [
            "ambiguous_context",
            "source_conflict",
            "must_content_unresolved",
            "user_constraint_overflow",
            "reconstruction_fact_risk"
          ]
        },
        "affected_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(src|item|atom|asset|constraint)[.]"
          },
          "uniqueItems": true
        },
        "impact": {
          "enum": [
            "none",
            "conclusion",
            "page_order",
            "emphasis",
            "action"
          ]
        },
        "resolution": {
          "enum": [
            "proceed",
            "present_both",
            "needs_user_choice"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "needs_user_choice"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "impact": {
                    "enum": [
                      "conclusion",
                      "page_order",
                      "emphasis",
                      "action"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "trigger": {
                    "enum": [
                      "must_content_unresolved",
                      "user_constraint_overflow",
                      "reconstruction_fact_risk"
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "present_both"
              }
            }
          },
          "then": {
            "properties": {
              "trigger": {
                "const": "source_conflict"
              }
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "purpose",
        "page_refs"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^section[.]"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "page_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^page[.]"
          },
          "uniqueItems": true
        }
      }
    },
    "relation_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "reason"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/relation_type"
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_type"
          },
          "uniqueItems": true,
          "maxItems": 2
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation_type": {
      "enum": [
        "focus",
        "sequence",
        "comparison",
        "hierarchy",
        "network",
        "flow",
        "cycle",
        "matrix",
        "spatial",
        "convergence",
        "funnel",
        "evidence",
        "decomposition",
        "mapping",
        "nesting"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "purpose",
        "importance",
        "semantic_form",
        "content_refs"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "semantic_form": {
          "enum": [
            "headline",
            "prose",
            "quote",
            "metrics",
            "table",
            "image-evidence",
            "process",
            "diagram",
            "code",
            "annotation",
            "cta"
          ]
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "order",
        "section_id",
        "role",
        "assertion_title",
        "audience_question",
        "takeaway",
        "content_refs",
        "evidence_refs",
        "relation_shape",
        "spatial_primitive",
        "blocks"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "section_id": {
          "type": "string",
          "pattern": "^section[.]"
        },
        "role": {
          "enum": [
            "hook",
            "orient",
            "explain",
            "prove",
            "compare",
            "sequence",
            "synthesize",
            "decide",
            "act",
            "close"
          ]
        },
        "assertion_title": {
          "type": "string",
          "minLength": 1
        },
        "audience_question": {
          "type": "string",
          "minLength": 1
        },
        "takeaway": {
          "type": "string",
          "minLength": 1
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "relation_shape": {
          "$ref": "#/$defs/relation_shape"
        },
        "spatial_primitive": {
          "$ref": "#/$defs/spatial_primitive"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          },
          "contains": {
            "type": "object",
            "required": [
              "importance"
            ],
            "properties": {
              "importance": {
                "const": "primary"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "coverage_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_ref",
        "disposition",
        "page_refs",
        "reason"
      ],
      "properties": {
        "content_ref": {
          "$ref": "#/$defs/content_ref"
        },
        "disposition": {
          "enum": [
            "include",
            "defer",
            "omit"
          ]
        },
        "page_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^page[.]"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "include"
              }
            }
          },
          "then": {
            "properties": {
              "page_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
