{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/content.schema.json",
  "title": "Wise PPT Content Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief",
    "sources",
    "content_items"
  ],
  "properties": {
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "uniqueItems": true
    },
    "content_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/content_item"
      }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "objective",
        "audience",
        "scenario",
        "language",
        "page_limits",
        "must_include",
        "must_avoid",
        "gaps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "page_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "requested": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "locator",
        "synthetic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src[.][a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "user_statement",
            "raw_text",
            "file",
            "url",
            "dataset",
            "image"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "atomic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^atom[.][a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "content_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target_ref",
        "reason"
      ],
      "properties": {
        "type": {
          "enum": [
            "supports",
            "contradicts",
            "depends_on",
            "elaborates"
          ]
        },
        "target_ref": {
          "type": "string",
          "pattern": "^(item|atom)[.]"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "priority",
        "status",
        "status_note",
        "source_refs",
        "atomic_values",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item[.][a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "assertion",
            "fact",
            "metric",
            "quote",
            "definition",
            "process",
            "comparison",
            "evidence",
            "table",
            "image",
            "code",
            "cta"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "status": {
          "enum": [
            "sourced",
            "inferred",
            "placeholder"
          ]
        },
        "status_note": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src[.]"
          },
          "uniqueItems": true
        },
        "atomic_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atomic_value"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_relation"
          }
        },
        "structured_data": {
          "type": "object"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "sourced"
              }
            }
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inferred",
                  "placeholder"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "status_note": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
