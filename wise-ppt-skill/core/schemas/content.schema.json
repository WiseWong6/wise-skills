{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/content.schema.json",
  "title": "Wise PPT Content Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "brief",
    "sources",
    "assets",
    "content_items"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "content_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/content_item"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "string",
      "pattern": "^src[.][a-z0-9][a-z0-9._-]*$"
    },
    "asset_ref": {
      "type": "string",
      "pattern": "^asset[.][a-z0-9][a-z0-9._-]*$"
    },
    "constraint_ref": {
      "type": "string",
      "pattern": "^constraint[.][a-z0-9][a-z0-9._-]*$"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "objective",
        "audience",
        "scenario",
        "language",
        "gaps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "user_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user_constraint"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "user_constraint": {
      "oneOf": [
        {
          "$ref": "#/$defs/page_limit_constraint"
        },
        {
          "$ref": "#/$defs/duration_constraint"
        },
        {
          "$ref": "#/$defs/content_constraint"
        },
        {
          "$ref": "#/$defs/other_constraint"
        }
      ]
    },
    "page_limit_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "type",
        "source_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_ref"
        },
        "type": {
          "const": "page_limit"
        },
        "exact_pages": {
          "type": "integer",
          "minimum": 1
        },
        "min_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "note": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "exact_pages"
          ]
        },
        {
          "required": [
            "min_pages"
          ]
        },
        {
          "required": [
            "max_pages"
          ]
        }
      ]
    },
    "duration_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "type",
        "source_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_ref"
        },
        "type": {
          "const": "duration"
        },
        "exact_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "note": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "exact_minutes"
          ]
        },
        {
          "required": [
            "min_minutes"
          ]
        },
        {
          "required": [
            "max_minutes"
          ]
        }
      ]
    },
    "content_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "type",
        "statement",
        "source_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_ref"
        },
        "type": {
          "const": "must_avoid"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "other_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "type",
        "statement",
        "source_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_ref"
        },
        "type": {
          "const": "other"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "nonempty_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_ref"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "locator",
        "synthetic"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_ref"
        },
        "kind": {
          "enum": [
            "user_statement",
            "raw_text",
            "file",
            "url",
            "dataset",
            "image"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "asset": {
      "oneOf": [
        {
          "$ref": "#/$defs/source_asset"
        },
        {
          "$ref": "#/$defs/reconstructed_asset"
        }
      ]
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "media_type",
        "locator",
        "sha256",
        "source_refs",
        "reconstruction_required"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/asset_ref"
        },
        "role": {
          "const": "source"
        },
        "media_type": {
          "type": "string",
          "pattern": "^image/"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "reconstruction_required": {
          "const": true
        }
      }
    },
    "reconstructed_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "creation_mode",
        "media_type",
        "locator",
        "sha256",
        "source_refs",
        "usage"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/asset_ref"
        },
        "role": {
          "const": "reconstructed"
        },
        "creation_mode": {
          "enum": [
            "reconstruct",
            "generate"
          ]
        },
        "media_type": {
          "type": "string",
          "pattern": "^image/"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_refs": {
          "$ref": "#/$defs/nonempty_source_refs"
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset_ref"
          },
          "uniqueItems": true
        },
        "reconstruction_method": {
          "enum": [
            "redraw",
            "recompose",
            "regenerate"
          ]
        },
        "reconstruction_reason": {
          "type": "string",
          "minLength": 8
        },
        "fact_change_risk": {
          "enum": [
            "none",
            "possible"
          ]
        },
        "generator": {
          "const": "codex-gpt-image-2"
        },
        "generation_reason": {
          "type": "string",
          "minLength": 8
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "const": "重构示意"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "creation_mode": {
                "const": "reconstruct"
              }
            }
          },
          "then": {
            "required": [
              "derived_from",
              "reconstruction_method",
              "reconstruction_reason",
              "fact_change_risk"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "creation_mode": {
                "const": "generate"
              }
            }
          },
          "then": {
            "required": [
              "generator",
              "generation_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "derived_from"
                  ]
                },
                {
                  "required": [
                    "reconstruction_method"
                  ]
                },
                {
                  "required": [
                    "reconstruction_reason"
                  ]
                },
                {
                  "required": [
                    "fact_change_risk"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "atomic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^atom[.][a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "content_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target_ref",
        "reason"
      ],
      "properties": {
        "type": {
          "enum": [
            "supports",
            "contradicts",
            "depends_on",
            "elaborates"
          ]
        },
        "target_ref": {
          "type": "string",
          "pattern": "^(item|atom)[.]"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "epistemic_role",
        "content_form",
        "statement",
        "priority",
        "status",
        "status_note",
        "source_refs",
        "atomic_values",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item[.][a-z0-9][a-z0-9._-]*$"
        },
        "epistemic_role": {
          "enum": [
            "claim",
            "fact",
            "evidence",
            "instruction"
          ]
        },
        "content_form": {
          "enum": [
            "prose",
            "metric",
            "quote",
            "definition",
            "process",
            "comparison",
            "table",
            "image",
            "code",
            "cta"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "status": {
          "enum": [
            "sourced",
            "inferred",
            "placeholder"
          ]
        },
        "status_note": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "uniqueItems": true
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset_ref"
          },
          "uniqueItems": true
        },
        "atomic_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atomic_value"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_relation"
          }
        },
        "structured_data": {
          "type": "object"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "sourced"
              }
            }
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inferred",
                  "placeholder"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "status_note": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_form": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "asset_refs"
            ],
            "properties": {
              "asset_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
