{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/render-plan.schema.json",
  "title": "Wise PPT Theme Render Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_file",
    "deck_plan_file",
    "theme_id",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "content_file": {
      "type": "string",
      "minLength": 1
    },
    "deck_plan_file": {
      "type": "string",
      "minLength": 1
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/render_page"
      }
    }
  },
  "$defs": {
    "content_ref": {
      "type": "string",
      "pattern": "^(item|atom)[.]"
    },
    "core_primitive": {
      "enum": [
        "focus-field",
        "bilateral-split",
        "peer-array",
        "linear-sequence",
        "parallel-tracks",
        "radial-burst",
        "nested-regions",
        "layered-stack",
        "matrix-field",
        "network-field",
        "converging-path",
        "evidence-annotation"
      ]
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "component",
        "content_refs",
        "theme_adapter"
      ],
      "properties": {
        "provider": {
          "enum": [
            "typography",
            "table",
            "image",
            "native-html",
            "echarts",
            "atlas",
            "svg"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "data_ref": {
          "type": "string",
          "minLength": 1
        },
        "encode": {
          "type": "object"
        },
        "theme_adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "renderer"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        }
      }
    },
    "html_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data-page-id",
        "data-page-role",
        "data-theme",
        "data-layout",
        "data-density",
        "data-reuse-mode"
      ],
      "properties": {
        "data-page-id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "data-page-role": {
          "enum": [
            "hook",
            "orient",
            "explain",
            "prove",
            "compare",
            "sequence",
            "synthesize",
            "decide",
            "act",
            "close"
          ]
        },
        "data-theme": {
          "type": "string",
          "minLength": 1
        },
        "data-layout": {
          "type": "string",
          "minLength": 1
        },
        "data-density": {
          "enum": [
            "breathing",
            "balanced",
            "dense"
          ]
        },
        "data-reuse-mode": {
          "enum": [
            "copy",
            "adapt",
            "compose",
            "novel"
          ]
        }
      }
    },
    "render_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "output_file",
        "layout_id",
        "density",
        "reuse_mode",
        "rationale",
        "capacity_status",
        "core_primitive",
        "theme_primitives",
        "html_attributes",
        "slots"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "output_file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[.][.]/).+[.]html$"
        },
        "layout_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "density": {
          "enum": [
            "breathing",
            "balanced",
            "dense"
          ]
        },
        "reuse_mode": {
          "enum": [
            "copy",
            "adapt",
            "compose",
            "novel"
          ]
        },
        "reuse_source": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        },
        "capacity_status": {
          "enum": [
            "fit",
            "underfill",
            "overflow",
            "unsupported"
          ]
        },
        "core_primitive": {
          "$ref": "#/$defs/core_primitive"
        },
        "theme_primitives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "html_attributes": {
          "$ref": "#/$defs/html_attributes"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reuse_mode": {
                "enum": [
                  "copy",
                  "adapt",
                  "compose"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reuse_source"
            ]
          }
        }
      ]
    }
  }
}
