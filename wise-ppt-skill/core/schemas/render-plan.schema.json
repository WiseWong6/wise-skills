{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/render-plan.schema.json",
  "title": "Wise PPT Theme Render Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "content_file",
    "deck_plan_file",
    "theme_id",
    "typography_mode",
    "output_file",
    "pages"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "content_file": {
      "type": "string",
      "minLength": 1
    },
    "deck_plan_file": {
      "type": "string",
      "minLength": 1
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "typography_mode": {
      "$ref": "#/$defs/typography_mode"
    },
    "output_file": {
      "const": "index.html"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/render_page"
      }
    }
  },
  "$defs": {
    "content_ref": {
      "type": "string",
      "pattern": "^(item|atom)[.]"
    },
    "asset_ref": {
      "type": "string",
      "pattern": "^asset[.]"
    },
    "typography_mode": {
      "enum": [
        "mixed",
        "all-sans",
        "all-serif"
      ]
    },
    "typography_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/typography_mode"
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "emphasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "none"
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "content_ref",
            "member_roles",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "semantic-focus"
            },
            "content_ref": {
              "$ref": "#/$defs/content_ref"
            },
            "member_roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "value",
                  "label",
                  "outline",
                  "status",
                  "symbol",
                  "texture",
                  "annotation"
                ]
              },
              "uniqueItems": true
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          }
        }
      ]
    },
    "candidate_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "verdict",
        "reason"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "verdict": {
          "enum": [
            "exact_fit",
            "structure_fit",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "payload_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "content_refs"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset_ref"
          },
          "uniqueItems": true
        }
      }
    },
    "gallery_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindings"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/payload_binding"
          }
        }
      }
    },
    "custom_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "min_items",
        "max_items"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_order",
        "regions"
      ],
      "properties": {
        "reading_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/custom_region"
          }
        }
      }
    },
    "layout_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/gallery_layout_decision"
        },
        {
          "$ref": "#/$defs/composition_layout_decision"
        },
        {
          "$ref": "#/$defs/custom_layout_decision"
        }
      ]
    },
    "gallery_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipe_id",
        "candidate_evaluations",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "gallery"
        },
        "recipe_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          },
          "contains": {
            "type": "object",
            "required": [
              "verdict"
            ],
            "properties": {
              "verdict": {
                "const": "exact_fit"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "verdict"
                ],
                "properties": {
                  "verdict": {
                    "const": "structure_fit"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 0
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/gallery_payload"
        }
      }
    },
    "composition_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipe_id",
        "candidate_evaluations"
      ],
      "properties": {
        "source": {
          "const": "composition"
        },
        "recipe_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          },
          "contains": {
            "type": "object",
            "required": [
              "verdict"
            ],
            "properties": {
              "verdict": {
                "const": "structure_fit"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "verdict"
                ],
                "properties": {
                  "verdict": {
                    "const": "exact_fit"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 0
            }
          ]
        }
      }
    },
    "custom_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "candidate_evaluations",
        "custom_contract"
      ],
      "properties": {
        "source": {
          "const": "custom"
        },
        "candidate_evaluations": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/candidate_evaluation"
              },
              {
                "properties": {
                  "verdict": {
                    "const": "reject"
                  }
                }
              }
            ]
          }
        },
        "custom_contract": {
          "$ref": "#/$defs/custom_contract"
        }
      }
    },
    "data_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id",
        "json_pointer"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^item[.]"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
        }
      }
    },
    "data_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_ref",
        "dataset_id",
        "encode"
      ],
      "properties": {
        "data_ref": {
          "$ref": "#/$defs/data_ref"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^dataset[.][a-z0-9][a-z0-9._-]*$"
        },
        "encode": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "material_treatment": {
      "oneOf": [
        {
          "$ref": "#/$defs/reconstruct_material_treatment"
        },
        {
          "$ref": "#/$defs/generate_material_treatment"
        }
      ]
    },
    "reconstruct_material_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_asset_refs",
        "strategy",
        "output_asset_ref",
        "reason"
      ],
      "properties": {
        "mode": {
          "const": "reconstruct"
        },
        "source_asset_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset_ref"
          },
          "uniqueItems": true
        },
        "strategy": {
          "enum": [
            "redraw",
            "recompose",
            "regenerate"
          ]
        },
        "output_asset_ref": {
          "$ref": "#/$defs/asset_ref"
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "generate_material_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "output_asset_ref",
        "reason"
      ],
      "properties": {
        "mode": {
          "const": "generate"
        },
        "output_asset_ref": {
          "$ref": "#/$defs/asset_ref"
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_kind",
        "component_source",
        "component_id",
        "content_refs",
        "theme_adapter_id"
      ],
      "properties": {
        "renderer_kind": {
          "enum": [
            "typography",
            "table",
            "image",
            "native-html",
            "svg",
            "canvas"
          ]
        },
        "component_source": {
          "enum": [
            "native",
            "echarts",
            "ppt-component-atlas",
            "codex-host"
          ]
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "data_binding": {
          "$ref": "#/$defs/data_binding"
        },
        "material_treatment": {
          "$ref": "#/$defs/material_treatment"
        },
        "theme_adapter_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "component_source": {
                "const": "echarts"
              }
            }
          },
          "then": {
            "required": [
              "data_binding"
            ],
            "properties": {
              "renderer_kind": {
                "enum": [
                  "svg",
                  "canvas"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "material_treatment"
            ],
            "properties": {
              "material_treatment": {
                "properties": {
                  "mode": {
                    "const": "generate"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "renderer_kind": {
                "const": "image"
              },
              "component_source": {
                "const": "codex-host"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component_source": {
                "const": "codex-host"
              }
            }
          },
          "then": {
            "properties": {
              "renderer_kind": {
                "const": "image"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "renderer_kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "material_treatment"
            ]
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "renderer"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        }
      }
    },
    "render_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "layout_decision",
        "rationale",
        "emphasis"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "layout_decision": {
          "$ref": "#/$defs/layout_decision"
        },
        "typography_decision": {
          "$ref": "#/$defs/typography_decision"
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        },
        "emphasis": {
          "$ref": "#/$defs/emphasis"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          },
          "contains": {
            "type": "object",
            "required": [
              "visual_role"
            ],
            "properties": {
              "visual_role": {
                "const": "primary"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "layout_decision": {
                "properties": {
                  "source": {
                    "const": "gallery"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "slots"
              ]
            }
          },
          "else": {
            "required": [
              "slots"
            ]
          }
        }
      ]
    }
  }
}
