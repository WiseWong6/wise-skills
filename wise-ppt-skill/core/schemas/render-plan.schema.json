{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/render-plan.schema.json",
  "title": "Wise PPT Theme Render Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_file",
    "deck_plan_file",
    "theme_id",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_file": {
      "type": "string",
      "minLength": 1
    },
    "deck_plan_file": {
      "type": "string",
      "minLength": 1
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "document_mode": {
      "const": "single-html"
    },
    "output_file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[.][.]/).+[.]html$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/render_page"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "document_mode"
        ],
        "properties": {
          "document_mode": {
            "const": "single-html"
          }
        }
      },
      "then": {
        "required": [
          "output_file"
        ],
        "properties": {
          "pages": {
            "items": {
              "allOf": [
                {
                  "not": {
                    "required": [
                      "output_file"
                    ]
                  }
                },
                {
                  "properties": {
                    "html_attributes": {
                      "required": [
                        "data-page-title",
                        "data-page-summary",
                        "data-section-id",
                        "data-section-title"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "pages": {
            "items": {
              "required": [
                "output_file"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "content_ref": {
      "type": "string",
      "pattern": "^(item|atom)[.]"
    },
    "core_primitive": {
      "enum": [
        "focus-field",
        "bilateral-split",
        "peer-array",
        "linear-sequence",
        "parallel-tracks",
        "radial-burst",
        "nested-regions",
        "layered-stack",
        "matrix-field",
        "network-field",
        "converging-path",
        "evidence-annotation"
      ]
    },
    "candidate_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_id",
        "verdict",
        "reason"
      ],
      "properties": {
        "layout_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "verdict": {
          "enum": [
            "fit",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "capacity_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "min_items",
        "max_items"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_order",
        "capacity",
        "regions"
      ],
      "properties": {
        "reading_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_units"
          ],
          "properties": {
            "semantic_units": {
              "$ref": "#/$defs/capacity_range"
            },
            "primary_items": {
              "$ref": "#/$defs/capacity_range"
            }
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/custom_region"
          }
        }
      }
    },
    "layout_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/gallery_layout_decision"
        },
        {
          "$ref": "#/$defs/custom_layout_decision"
        }
      ]
    },
    "gallery_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reuse_mode",
        "layout_id",
        "candidate_evaluations"
      ],
      "properties": {
        "source": {
          "const": "gallery"
        },
        "reuse_mode": {
          "enum": [
            "copy",
            "adapt"
          ]
        },
        "layout_id": {
          "type": "string",
          "pattern": "^(?!custom[.])[a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          }
        }
      }
    },
    "custom_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reuse_mode",
        "layout_id",
        "candidate_evaluations",
        "custom_contract"
      ],
      "properties": {
        "source": {
          "const": "custom"
        },
        "reuse_mode": {
          "const": "custom"
        },
        "layout_id": {
          "type": "string",
          "pattern": "^custom[.][a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          }
        },
        "custom_contract": {
          "$ref": "#/$defs/custom_contract"
        }
      }
    },
    "component_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "keep",
            "replace",
            "select"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "component",
        "content_refs",
        "theme_adapter"
      ],
      "properties": {
        "provider": {
          "enum": [
            "typography",
            "table",
            "image",
            "native-html",
            "echarts",
            "atlas",
            "svg"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "data_ref": {
          "type": "string",
          "minLength": 1
        },
        "encode": {
          "type": "object"
        },
        "theme_adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "component_decision",
        "renderer"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "component_decision": {
          "$ref": "#/$defs/component_decision"
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        }
      }
    },
    "html_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data-page-id",
        "data-page-role",
        "data-theme",
        "data-layout-source",
        "data-layout",
        "data-density",
        "data-reuse-mode"
      ],
      "properties": {
        "data-page-id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "data-page-role": {
          "enum": [
            "hook",
            "orient",
            "explain",
            "prove",
            "compare",
            "sequence",
            "synthesize",
            "decide",
            "act",
            "close"
          ]
        },
        "data-theme": {
          "type": "string",
          "minLength": 1
        },
        "data-layout-source": {
          "enum": [
            "gallery",
            "custom"
          ]
        },
        "data-layout": {
          "type": "string",
          "minLength": 1
        },
        "data-density": {
          "enum": [
            "breathing",
            "balanced",
            "dense"
          ]
        },
        "data-reuse-mode": {
          "enum": [
            "copy",
            "adapt",
            "custom"
          ]
        },
        "data-page-title": {
          "type": "string",
          "minLength": 1
        },
        "data-page-summary": {
          "type": "string",
          "minLength": 1
        },
        "data-section-id": {
          "type": "string",
          "pattern": "^section[.]"
        },
        "data-section-title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "render_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "layout_decision",
        "density",
        "rationale",
        "capacity_status",
        "core_primitive",
        "html_attributes",
        "slots"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "output_file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[.][.]/).+[.]html$"
        },
        "layout_decision": {
          "$ref": "#/$defs/layout_decision"
        },
        "density": {
          "enum": [
            "breathing",
            "balanced",
            "dense"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        },
        "capacity_status": {
          "enum": [
            "fit",
            "underfill",
            "overflow",
            "unsupported"
          ]
        },
        "core_primitive": {
          "$ref": "#/$defs/core_primitive"
        },
        "html_attributes": {
          "$ref": "#/$defs/html_attributes"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    }
  }
}
