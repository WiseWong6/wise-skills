{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-ppt.local/schemas/render-plan.schema.json",
  "title": "Wise PPT Theme Render Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_file",
    "deck_plan_file",
    "theme_id",
    "output_file",
    "pages"
  ],
  "properties": {
    "content_file": {
      "type": "string",
      "minLength": 1
    },
    "deck_plan_file": {
      "type": "string",
      "minLength": 1
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "output_file": {
      "const": "index.html"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/render_page"
      }
    }
  },
  "$defs": {
    "content_ref": {
      "type": "string",
      "pattern": "^(item|atom)[.]"
    },
    "emphasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "none"
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "content_ref",
            "member_roles",
            "reason"
          ],
          "properties": {
            "mode": {
              "const": "semantic-focus"
            },
            "content_ref": {
              "$ref": "#/$defs/content_ref"
            },
            "member_roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "value",
                  "label",
                  "outline",
                  "status",
                  "symbol",
                  "texture",
                  "annotation"
                ]
              },
              "uniqueItems": true
            },
            "reason": {
              "type": "string",
              "minLength": 8
            }
          }
        }
      ]
    },
    "candidate_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_id",
        "verdict",
        "reason"
      ],
      "properties": {
        "layout_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "verdict": {
          "enum": [
            "fit",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "capacity_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "min_items",
        "max_items"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_order",
        "capacity",
        "regions"
      ],
      "properties": {
        "reading_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_units"
          ],
          "properties": {
            "semantic_units": {
              "$ref": "#/$defs/capacity_range"
            },
            "primary_items": {
              "$ref": "#/$defs/capacity_range"
            }
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/custom_region"
          }
        }
      }
    },
    "layout_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/gallery_layout_decision"
        },
        {
          "$ref": "#/$defs/custom_layout_decision"
        }
      ]
    },
    "gallery_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reuse_mode",
        "layout_id",
        "candidate_evaluations"
      ],
      "properties": {
        "source": {
          "const": "gallery"
        },
        "reuse_mode": {
          "enum": [
            "copy",
            "adapt"
          ]
        },
        "layout_id": {
          "type": "string",
          "pattern": "^(?!custom[.])[a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          }
        }
      }
    },
    "custom_layout_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reuse_mode",
        "layout_id",
        "candidate_evaluations",
        "custom_contract"
      ],
      "properties": {
        "source": {
          "const": "custom"
        },
        "reuse_mode": {
          "const": "custom"
        },
        "layout_id": {
          "type": "string",
          "pattern": "^custom[.][a-z0-9][a-z0-9.-]*$"
        },
        "candidate_evaluations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate_evaluation"
          }
        },
        "custom_contract": {
          "$ref": "#/$defs/custom_contract"
        }
      }
    },
    "component_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "keep",
            "replace",
            "select"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "component",
        "content_refs",
        "theme_adapter"
      ],
      "properties": {
        "provider": {
          "enum": [
            "typography",
            "table",
            "image",
            "native-html",
            "echarts",
            "atlas",
            "svg"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "uniqueItems": true
        },
        "data_ref": {
          "type": "string",
          "minLength": 1
        },
        "encode": {
          "type": "object"
        },
        "theme_adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "block_id",
        "visual_role",
        "component_decision",
        "renderer"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "pattern": "^block[.]"
        },
        "visual_role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "component_decision": {
          "$ref": "#/$defs/component_decision"
        },
        "renderer": {
          "$ref": "#/$defs/renderer"
        }
      }
    },
    "render_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "layout_decision",
        "rationale",
        "emphasis",
        "slots"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^page[.]"
        },
        "layout_decision": {
          "$ref": "#/$defs/layout_decision"
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        },
        "emphasis": {
          "$ref": "#/$defs/emphasis"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    }
  }
}
