{
  "schema_version": "1.0",
  "description": "Core renderer component capabilities. This manifest supports deterministic filtering only; Core still decides the semantic task.",
  "components": [
    {
      "component_id": "typography.statement",
      "name": "判断大字",
      "description": "以一句 assertion 或 takeaway 为唯一视觉主角。",
      "tasks": ["statement", "takeaway"],
      "roles": ["hook", "orient", "synthesize", "decide", "act", "close"],
      "relations": ["focus"],
      "densities": ["breathing", "balanced"],
      "providers": ["typography"],
      "capacity": {"semantic_units": {"min": 1, "max": 2}},
      "selection_notes": "适合单一判断；不承担多变量比较。"
    },
    {
      "component_id": "typography.big-number",
      "name": "大数字",
      "description": "呈现单个 KPI、比例或关键计数及其单位。",
      "tasks": ["kpi", "metric"],
      "roles": ["hook", "prove", "synthesize"],
      "relations": ["focus", "comparison"],
      "densities": ["breathing", "balanced"],
      "providers": ["typography"],
      "capacity": {"semantic_units": {"min": 1, "max": 4}},
      "selection_notes": "用于 1–4 个可直接读出的指标；复杂坐标关系改用图表。"
    },
    {
      "component_id": "typography.quote",
      "name": "引语",
      "description": "保留原文、说话人和来源的引用组件。",
      "tasks": ["quote", "citation"],
      "roles": ["hook", "prove", "close"],
      "relations": ["focus", "evidence"],
      "densities": ["breathing", "balanced"],
      "providers": ["typography"],
      "capacity": {"semantic_units": {"min": 1, "max": 2}},
      "selection_notes": "必须有 content/source 引用；不把改写文字伪装成原话。"
    },
    {
      "component_id": "table.data-grid",
      "name": "数据表",
      "description": "保留行列关系、单位和精确查值能力。",
      "tasks": ["lookup", "comparison", "specification"],
      "roles": ["explain", "prove", "compare", "decide"],
      "relations": ["comparison", "matrix", "mapping"],
      "densities": ["balanced", "dense"],
      "providers": ["table"],
      "capacity": {"primary_items": {"min": 2, "max": 12}},
      "selection_notes": "需要逐字段查值时使用；不能为追求视觉效果拆散表格语义。"
    },
    {
      "component_id": "image.evidence",
      "name": "图像证据",
      "description": "承载截图、照片、扫描件或原始文档图像。",
      "tasks": ["evidence", "screenshot", "photo"],
      "roles": ["hook", "explain", "prove", "compare"],
      "relations": ["focus", "evidence", "comparison", "spatial"],
      "densities": ["breathing", "balanced", "dense"],
      "providers": ["image"],
      "capacity": {"primary_items": {"min": 1, "max": 6}},
      "selection_notes": "裁切和标注不得改变证据含义；必须保留来源。"
    },
    {
      "component_id": "native-html.interface",
      "name": "界面或文档面板",
      "description": "用语义 DOM 呈现 UI、终端、代码、配置或高密信息面板。",
      "tasks": ["ui", "code", "document", "specification"],
      "roles": ["explain", "prove", "compare", "act"],
      "relations": ["focus", "comparison", "hierarchy", "matrix", "evidence"],
      "densities": ["balanced", "dense"],
      "providers": ["native-html"],
      "capacity": {"semantic_units": {"min": 1, "max": 12}},
      "selection_notes": "关键状态须静态可见；不能用整图替代可读 DOM。"
    },
    {
      "component_id": "echarts.line",
      "name": "折线图",
      "description": "表达连续趋势、时间序列与多系列变化。",
      "tasks": ["trend", "time-series", "multi-series"],
      "roles": ["explain", "prove", "compare", "synthesize", "decide"],
      "relations": ["sequence", "comparison", "flow"],
      "densities": ["balanced", "dense"],
      "providers": ["echarts"],
      "capacity": {"primary_items": {"min": 4, "max": 12}},
      "requires": ["data_ref", "encode.x", "encode.y"],
      "selection_notes": "存在连续尺度或时间轴时使用；单个 KPI 不需要折线图。"
    },
    {
      "component_id": "echarts.bar",
      "name": "条形图",
      "description": "比较多个类别的可比量级、排序或成组差异。",
      "tasks": ["ranking", "category-comparison", "distribution"],
      "roles": ["explain", "prove", "compare", "decide"],
      "relations": ["comparison", "matrix"],
      "densities": ["balanced", "dense"],
      "providers": ["echarts"],
      "capacity": {"primary_items": {"min": 4, "max": 12}},
      "requires": ["data_ref", "encode.category", "encode.value"],
      "selection_notes": "类别必须共享可比量纲；排序需在 encode 中显式声明。"
    },
    {
      "component_id": "echarts.scatter",
      "name": "散点图",
      "description": "表达两个连续变量的相关性、聚类或离群值。",
      "tasks": ["correlation", "cluster", "outlier"],
      "roles": ["explain", "prove", "compare", "decide"],
      "relations": ["comparison", "matrix", "spatial"],
      "densities": ["balanced", "dense"],
      "providers": ["echarts"],
      "capacity": {"primary_items": {"min": 6, "max": 12}},
      "requires": ["data_ref", "encode.x", "encode.y"],
      "selection_notes": "只有两个量轴都具有含义时使用；必须解释离群或聚类编码。"
    },
    {
      "component_id": "echarts.composition",
      "name": "构成图",
      "description": "表达有限类别对整体的构成关系。",
      "tasks": ["composition", "share-of-whole"],
      "roles": ["explain", "prove", "compare", "synthesize"],
      "relations": ["decomposition", "comparison"],
      "densities": ["balanced"],
      "providers": ["echarts"],
      "capacity": {"primary_items": {"min": 2, "max": 6}},
      "requires": ["data_ref", "encode.name", "encode.value"],
      "selection_notes": "类别过多或需要精确比较时应改用条形图或表格。"
    },
    {
      "component_id": "echarts.map",
      "name": "地理编码图",
      "description": "把指标绑定到真实地域、坐标或地理层级。",
      "tasks": ["geography", "regional-comparison"],
      "roles": ["explain", "prove", "compare"],
      "relations": ["spatial", "comparison", "mapping"],
      "densities": ["balanced", "dense"],
      "providers": ["echarts"],
      "capacity": {"semantic_units": {"min": 2, "max": 12}},
      "requires": ["data_ref", "encode.region", "encode.value"],
      "selection_notes": "只有地域本身参与论证时使用；装饰性地图应删除。"
    },
    {
      "component_id": "svg.relationship",
      "name": "程序化关系图",
      "description": "用节点、路径、引线、层级或空间图元表达独特关系。",
      "tasks": ["sequence", "network", "hierarchy", "flow", "annotation"],
      "roles": ["hook", "orient", "explain", "prove", "compare", "sequence", "synthesize"],
      "relations": ["sequence", "comparison", "hierarchy", "network", "flow", "cycle", "spatial", "convergence", "mapping", "nesting"],
      "densities": ["breathing", "balanced", "dense"],
      "providers": ["svg"],
      "capacity": {"semantic_units": {"min": 1, "max": 12}},
      "selection_notes": "图元和线型必须编码真实语义；不能做 decoration-only 插图。"
    }
  ]
}
