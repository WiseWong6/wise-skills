{
  "schema_version": "2.0",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "pages": [
    {
      "page_id": "page.example-architecture-spec",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "copy",
        "layout_id": "paper-ink.decomposition.structure-spec-split",
        "candidate_evaluations": [
          {
            "layout_id": "paper-ink.decomposition.structure-spec-split",
            "verdict": "fit",
            "reason": "角色、层级关系、空间原语、容量与槽位顺序均符合本页需求。"
          }
        ]
      },
      "rationale": "三层依赖树与三行规格字段需要左右对位，现有结构加规格单版式的插槽、层级关系与 2–12 个语义单元容量完全匹配，直接复用可保持高密度下的清晰映射。",
      "slots": [
        {
          "slot_id": "structure",
          "block_id": "block.architecture",
          "visual_role": "primary",
          "component_decision": {
            "action": "keep",
            "reason": "结构主槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "svg",
            "component": "architecture-tree",
            "content_refs": [
              "item.system-architecture"
            ],
            "data_ref": "item.system-architecture",
            "encode": {
              "node": "name",
              "parent": "depends_on"
            },
            "theme_adapter": "paper-ink.svg"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.specifications",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "规格支撑槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "table",
            "component": "spec-table",
            "content_refs": [
              "item.system-specifications"
            ],
            "data_ref": "item.system-specifications",
            "encode": {
              "key": "layer",
              "value": [
                "contract",
                "stable"
              ]
            },
            "theme_adapter": "paper-ink.table"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.architecture-takeaway",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "结论槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": [
              "item.architecture-takeaway"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    }
  ],
  "document_mode": "single-html",
  "output_file": "index.html"
}
