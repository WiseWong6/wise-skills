{
  "schema_version": "2.0",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "pages": [
    {
      "page_id": "page.example-matrix-atlas-process",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "paper-ink.matrix.stage-dimension",
        "candidate_evaluations": [
          {
            "layout_id": "paper-ink.matrix.stage-dimension",
            "verdict": "fit",
            "reason": "角色、矩阵关系、空间原语、容量与槽位顺序均符合本页需求。"
          }
        ]
      },
      "rationale": "四阶段和三类能力形成 3×4 映射，先用 atlas 四步组件建立列方向，再由矩阵表承载十二个交叉结果；三个语义单元处于该版式 2–12 容量内。",
      "slots": [
        {
          "slot_id": "framework",
          "block_id": "block.stage-process",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "以 Atlas 四步流程替换样例中的通用主视觉。"
          },
          "renderer": {
            "provider": "atlas",
            "component": "流程-默认变体(4步)",
            "variant": "default",
            "content_refs": [
              "item.delivery-stages"
            ],
            "data_ref": "item.delivery-stages",
            "encode": {
              "order": "stages",
              "label": "stages"
            },
            "theme_adapter": "paper-ink.atlas"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.capability-matrix",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "矩阵支撑槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "table",
            "component": "matrix-body",
            "content_refs": [
              "item.stage-capability-matrix"
            ],
            "data_ref": "item.stage-capability-matrix",
            "encode": {
              "columns": "columns",
              "rows": "rows",
              "value": "deliverable"
            },
            "theme_adapter": "paper-ink.table"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.framework-takeaway",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "结论槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": [
              "item.framework-takeaway"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "none",
        "reason": "本页保持默认单色，不声明语义强调焦点。"
      }
    }
  ],
  "document_mode": "single-html",
  "output_file": "index.html"
}
