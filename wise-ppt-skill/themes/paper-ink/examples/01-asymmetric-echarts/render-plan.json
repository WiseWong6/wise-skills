{
  "schema_version": "2.0",
  "content_file": "content.json",
  "deck_plan_file": "deck-plan.json",
  "theme_id": "paper-ink",
  "pages": [
    {
      "page_id": "page.example-asymmetric-echarts",
      "layout_decision": {
        "source": "gallery",
        "reuse_mode": "adapt",
        "layout_id": "paper-ink.data.visual-kpi-split",
        "candidate_evaluations": [
          {
            "layout_id": "paper-ink.data.visual-kpi-split",
            "verdict": "fit",
            "reason": "角色、证据关系、分栏原语、容量与槽位顺序均符合本页需求。"
          }
        ]
      },
      "rationale": "三项内容是一条趋势证据链，左侧约三分之二承载连续变化，右侧只提炼结果；非对称分栏保留主次并符合 2–7 个语义单元容量。",
      "slots": [
        {
          "slot_id": "visual",
          "block_id": "block.metric-trend",
          "visual_role": "primary",
          "component_decision": {
            "action": "replace",
            "reason": "以真实趋势 ECharts 替换画廊样例中的通用主视觉。"
          },
          "renderer": {
            "provider": "echarts",
            "component": "line",
            "content_refs": [
              "item.metric-retention-series"
            ],
            "data_ref": "item.metric-retention-series",
            "encode": {
              "x": "week",
              "y": [
                "old",
                "new"
              ],
              "focus": "new"
            },
            "theme_adapter": "paper-ink.echarts"
          }
        },
        {
          "slot_id": "support",
          "block_id": "block.metric-kpis",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "KPI 支撑槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "kpi-stack",
            "content_refs": [
              "item.metric-retention-summary"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        },
        {
          "slot_id": "takeaway",
          "block_id": "block.metric-takeaway",
          "visual_role": "support",
          "component_decision": {
            "action": "keep",
            "reason": "结论槽位与样例结构及语义完全一致。"
          },
          "renderer": {
            "provider": "typography",
            "component": "takeaway",
            "content_refs": [
              "item.metric-takeaway"
            ],
            "theme_adapter": "paper-ink.typography"
          }
        }
      ],
      "emphasis": {
        "mode": "semantic-focus",
        "content_ref": "item.metric-retention-series",
        "member_roles": [
          "outline"
        ],
        "reason": "强调新版留存序列的折线与数据点轮廓，不把坐标和辅助标签误染。"
      }
    }
  ],
  "document_mode": "single-html",
  "output_file": "index.html"
}
