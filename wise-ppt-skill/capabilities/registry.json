{
  "contract_version": 2,
  "registry_id": "wise-ppt-capabilities",
  "renderer_kinds": [
    {
      "renderer_kind": "typography",
      "description": "用可选中的文本排版表达信息"
    },
    {
      "renderer_kind": "table",
      "description": "用表格表达需要精确查值的数据"
    },
    {
      "renderer_kind": "image",
      "description": "用本地位图或矢量图片文件表达信息"
    },
    {
      "renderer_kind": "native-html",
      "description": "用原生 HTML 与 CSS 结构表达信息"
    },
    {
      "renderer_kind": "svg",
      "description": "用内联或本地 SVG 表达信息"
    },
    {
      "renderer_kind": "canvas",
      "description": "用 Canvas 绘制信息"
    }
  ],
  "component_sources": [
    {
      "component_source": "native",
      "description": "Wise PPT 自有组件",
      "allowed_renderer_kinds": [
        "typography",
        "table",
        "image",
        "native-html",
        "svg",
        "canvas"
      ]
    },
    {
      "component_source": "echarts",
      "description": "Apache ECharts 图表组件",
      "allowed_renderer_kinds": [
        "svg",
        "canvas"
      ]
    },
    {
      "component_source": "ppt-component-atlas",
      "description": "PPT Component Atlas 导出的组件",
      "allowed_renderer_kinds": [
        "native-html",
        "svg"
      ]
    },
    {
      "component_source": "codex-host",
      "description": "Codex 宿主内置图片能力生成或重构的媒体",
      "allowed_renderer_kinds": [
        "image"
      ]
    }
  ],
  "capabilities": [
    {
      "capability_id": "layout-gallery",
      "capability_kind": "layout-catalog",
      "manifest": "capabilities/layouts/gallery-manifest.json",
      "reference": "capabilities/references/layout-gallery.md"
    },
    {
      "capability_id": "echarts",
      "capability_kind": "component-source",
      "component_source": "echarts",
      "runtime": "capabilities/vendors/echarts/echarts.min.js",
      "version": "6.1.0",
      "license": "Apache-2.0",
      "dataset_docs": "https://echarts.apache.org/handbook/en/concepts/dataset/",
      "reference": "capabilities/references/component-routing.md"
    },
    {
      "capability_id": "ppt-component-atlas",
      "capability_kind": "component-source",
      "component_source": "ppt-component-atlas",
      "reference": "capabilities/references/component-routing.md"
    },
    {
      "capability_id": "codex-host-image",
      "capability_kind": "component-source",
      "component_source": "codex-host",
      "reference": "capabilities/references/media-contract.md"
    }
  ]
}
